{
  "DstApi": {
    // Local: Get this URL from MPC.VCO.DST.WebSite.API/Properties/launchSettings.json.
    // Azure: Use the Application URL of the deployed DST API Azure Container App.
    "BaseUrl": "https://localhost:7253/",

    // Microsoft Entra ID -> App registrations -> DST API app registration
    // -> Expose an API -> Scopes defined by this API.
    "Scopes": [
      ""
    ]
  },

 

  "AzureAd": {

    "Instance": "https://login.microsoftonline.com/",

    // Azure Portal -> Microsoft Entra ID -> Overview -> Tenant ID.
    "TenantId": "",

    // Microsoft Entra ID -> App registrations -> DST Web/UI app registration
    // -> Overview -> Application (client) ID.
    "ClientId": "",

    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}