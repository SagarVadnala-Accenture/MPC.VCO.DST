// API project - appsettings.json

{
  "Cors": {
    "AllowedOrigins": [
      // Local UI URL:
      // MPC.VCO.DST.WebSite -> Properties -> launchSettings.json
      // Use the HTTPS applicationUrl of the UI project.
      "https://localhost:7253",

      // Deployed UI URL:
      // Azure Portal -> Container Apps -> MPC DST UI Container App
      // -> Overview -> Application URL.
      ""
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "CosmosDb": {
    // Azure Portal -> Azure Cosmos DB -> MPC/VCO DST Cosmos DB account
    // -> Overview -> URI.
    "Endpoint": "",

    // Azure Portal -> Cosmos DB account -> Data Explorer
    // -> Database name.
    "DatabaseName": "",

    // Azure Portal -> Cosmos DB -> Data Explorer -> VcoDstDb
    // -> Container used for planning-cycle/model data.
    "ContainerName": "PlanningData",

    // Azure Portal -> Cosmos DB -> Data Explorer -> VcoDstDb
    // -> Container used for model notes.
    "ModelNotesContainerName": "ModelNotes"
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",

    // Azure Portal -> Microsoft Entra ID -> Overview
    // -> Tenant ID.
    "TenantId": "",

    // Microsoft Entra ID -> App registrations
    // -> DST API app registration -> Overview
    // -> Application (client) ID.
    "ClientId": "",

    // Microsoft Entra ID -> App registrations
    // -> DST API app registration -> Expose an API
    // -> Application ID URI.
    // Normally: api://{API-ClientId}
    "Audience": "",

    // Microsoft Entra ID -> App registrations
    // -> DST API app registration -> Expose an API
    // -> Scopes defined by this API.
    "Scopes": [
      ""
    ]
  },

  "MentionUsers": {
    // Microsoft Entra ID -> Groups
    // -> Open the group whose members are allowed to appear in @mentions
    // -> Overview -> Object ID.
 
    "AllowedGroupId": ""
  },

  "Graph": {
    // Microsoft Graph delegated/application permissions required by
    // the API's mention-user lookup implementation.
    //
    // Microsoft Entra ID -> App registrations -> DST API
    // -> API permissions -> Microsoft Graph.
    //
    // User.ReadBasic.All:
    // Used to read basic user profile information.
    //
    // GroupMember.ReadBasic.All:
    // Used when checking/reading membership of the allowed mention group.
    "Scopes": [
      "https://graph.microsoft.com/User.ReadBasic.All",
      "https://graph.microsoft.com/GroupMember.ReadBasic.All"
    ]
  },

  "Swagger": {
   
    "ClientId": ""
  }
}